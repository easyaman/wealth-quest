## `WQPlayer.acted(kind)` → id เสียง
##
## **"dream" ไม่อยู่ในนี้โดยตั้งใจ** — `claim_dream()` เรียก `match_ref.add_champion()`
## ซึ่งยิง `player_finished` ตามมาทันที ถ้าใส่ไว้ด้วยเสียงชนะจะดังซ้อนกันสองครั้ง
const FROM_ACTED := {
	"travel": "travel", "buy": "buy", "sell": "sell", "loan": "loan", "repay": "repay",
	"ot": "ot", "freelance": "freelance", "scout": "scout", "study": "study",
	"gym": "gym", "resort": "resort", "rest": "rest", "lifestyle": "lifestyle",
	"phase2": "phase2",
}

## เสียงที่ `ui/` เรียกเองได้ผ่าน `WQAudio.ui()` — นอกรายการนี้ต้องมาจากสัญญาณเท่านั้น
##
## ลูกเต๋าอยู่ในเลนนี้เพราะมันคือ **ภาพเคลื่อนไหว** ไม่ใช่การเปลี่ยนสถานะ —
## แต้มถูกทอยจาก core ไปเรียบร้อยแล้วก่อนที่ลูกเต๋าจะเริ่มหมุนบนจอ
const UI_IDS := ["click", "panel_open", "panel_close", "denied", "tutorial_step",
	"save", "load", "dice_roll", "dice_land"]


static func ids() -> Array:
	var out := SPEC.keys()
	out.sort()
	return out
