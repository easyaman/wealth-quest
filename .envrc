# .envrc — generated by /navenv init. Safe to commit (contains no secrets).
# Requires direnv: https://direnv.net  (brew install direnv; hook into ~/.zshrc)
# Loads THIS project's private env so each shell / terminal / Claude session is isolated.

NAVENV_ROOT="$(pwd)"
NAVENV_KEY="$(command -v jq >/dev/null && jq -r .key .navenv.json 2>/dev/null || sed -n 's/.*"key": *"\([^"]*\)".*/\1/p' .navenv.json | head -1)"
export NAVENV_KEY NAVENV_ROOT

secrets="$HOME/.claude/navenv/${NAVENV_KEY}.env"
if [ -f "$secrets" ]; then
  source_env "$secrets"
else
  echo "navenv: ⚠ $secrets not found — run /navenv init or copy assets/env.template" >&2
fi

# Isolate gh login state per project (created on first `gh auth login` inside this dir)
export GH_CONFIG_DIR="${GH_CONFIG_DIR:-$HOME/.claude/navenv/gh/$NAVENV_KEY}"
mkdir -p "$GH_CONFIG_DIR"

# Project-local env (public-ish config, per repo)
dotenv_if_exists .env.local
