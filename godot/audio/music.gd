class_name WQMusic
extends RefCounted
## ช่องเพลงพื้นหลังของเกม — **ที่นี่ไม่มีทำนอง มีแต่ "ช่องว่างที่รอไฟล์"**
##
## เคยมีตารางโน้ตกับตัวเรียบเรียงที่แต่งเพลงเองจากโค้ด (commit a54d449..9dc38b3) แต่เจ้าของ
## โปรเจกต์ฟังของจริงแล้วสั่งทิ้งทั้งหมด — เพลงจะเป็นไฟล์ที่คนทำมาวางเอง โค้ดจึงเหลือหน้าที่เดียว:
## บอกว่ามีช่องอะไรบ้าง แต่ละช่องดังตอนไหน และไฟล์ต้องไปวางที่ไหน
##
## ท่อที่เหลือยังอยู่ครบใน `audio/audio.gd` — บัส Music · ตัวเล่นสองตัวเฟดไขว้ · สไลเดอร์ในแผง
## · นโยบายเลือกเพลงตามด่าน/วิกฤต วางไฟล์ลงโฟลเดอร์แล้วเล่นได้ทันทีโดยไม่ต้องแก้โค้ดสักบรรทัด

const DIR := "res://audio/music"

## นามสกุลที่ Godot 4 นำเข้าเป็นเสียงได้ เรียงตามลำดับที่จะเลือกถ้าช่องเดียวมีหลายไฟล์
## **ไม่มี `.mp4`** — Godot นำเข้าไม่ได้ ต้องแปลงก่อน:  ffmpeg -i เพลง.mp4 -vn -c:a libvorbis เพลง.ogg
## แนะนำ `.ogg` สำหรับเพลงยาว ไฟล์เล็กกว่า `.wav` หลายเท่าและลูปได้เนียน
const EXTS := ["ogg", "mp3", "wav"]

## ช่อง → ดังตอนไหน · `audio/README.md` สร้างตารางจากตัวนี้ ห้ามพิมพ์รายชื่อซ้ำที่อื่น
const SLOTS := {
	"phase1": "ด่าน 1 หรือยังไม่เริ่มแมตช์",
	"phase2": "ด่าน 2",
	"crisis": "สุขภาพต่ำกว่าเกณฑ์วิกฤต หรือมีภัยพิบัติค้างอยู่",
}


static func ids() -> Array:
	var out := SLOTS.keys()
	out.sort()
	return out


## ไฟล์ของช่องนี้เอง — คืน "" ถ้ายังไม่มีใครวางไฟล์ให้ช่องนี้
static func own_path(id: String) -> String:
	for ext in EXTS:
		var p := "%s/%s.%s" % [DIR, id, ext]
		if ResourceLoader.exists(p): return p
	return ""


## ไฟล์ที่ช่องนี้จะเล่นจริง — **ถ้าช่องตัวเองยังว่าง ให้ยืมไฟล์แรกที่มีจากช่องอื่น**
##
## มีเพราะคนทำเพลงส่งงานมาทีละไฟล์ ถ้าช่องที่ยังว่างแปลว่าเงียบสนิท เกมจะเงียบตอนเข้าด่าน 2
## ทั้งที่เพิ่งได้ยินเพลงอยู่เมื่อครู่ — ผู้เล่นจะอ่านว่า "เสียงพัง" ไม่ใช่ "เพลงนี้ยังไม่ได้ทำ"
## ยืมกันไปก่อนแล้วค่อยเต็มทีละช่องจึงเป็นสภาพระหว่างทางที่ฟังดูตั้งใจกว่า
static func path_for(id: String) -> String:
	var own := own_path(id)
	if own != "": return own
	for other in ids():
		var p := own_path(String(other))
		if p != "": return p
	return ""


## มีไฟล์เพลงในโปรเจกต์แล้วอย่างน้อยหนึ่งไฟล์ไหม — ไม่มี = เกมเงียบอย่างสงบ ไม่ใช่ error
static func has_any() -> bool:
	for id in ids():
		if own_path(String(id)) != "": return true
	return false
